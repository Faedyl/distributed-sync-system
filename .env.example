# Distributed Synchronization System - example environment

# Identity of this node within the cluster
NODE_ID=node1

# Bind address for HTTP server (inter-node + client API)
NODE_BIND=0.0.0.0:8001

# Comma-separated peers in the form id@host:port (include self for full membership)
PEERS=node1@node1:8001,node2@node2:8001,node3@node3:8001

# Persistence
DATA_DIR=/var/lib/dsync

# Redis (optional shared metadata; queue/cache fall back to local if unset)
REDIS_URL=redis://redis:6379/0

# Raft tuning (milliseconds)
RAFT_HEARTBEAT_MS=120
RAFT_ELECTION_MIN_MS=400
RAFT_ELECTION_MAX_MS=800

# Logging
LOG_LEVEL=INFO

# Cache
CACHE_CAPACITY=1024
CACHE_POLICY=LRU

# Queue
QUEUE_REPLICATION_FACTOR=2
QUEUE_VIRTUAL_NODES=128
